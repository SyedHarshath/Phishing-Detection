# Reference only: the project does not automatically load .env files.
# Set these values in the process environment or the hosting dashboard.

# Use an absolute path for a persistent production database location.
PHISHGUARD_ENV=development
PHISHGUARD_DATABASE_PATH=C:/replace-with-a-private-absolute-path/predictions.sqlite
PHISHGUARD_MAX_URL_LENGTH=4096
LOG_LEVEL=INFO

# Optional only when an active registry is not used. In production, provide
# both explicit paths and a reviewed release version, or use an existing
# PHISHGUARD_ACTIVE_MODEL_MANIFEST.
# PHISHGUARD_ACTIVE_MODEL_MANIFEST=/absolute/path/to/active.json
# PHISHGUARD_MODEL_PATH=/absolute/path/to/best_model.h5
# PHISHGUARD_TOKENIZER_PATH=/absolute/path/to/tokenizer.json
# PHISHGUARD_MODEL_VERSION=reviewed-model-release

# Optional token for the sensitive /predictions history endpoint. Generate it
# locally and store it in a secret manager; never put it in the extension.
PHISHGUARD_PREDICTIONS_TOKEN=replace-with-a-locally-generated-secret

# Operational retraining controls. Keep disabled until provenance and policy
# prerequisites have been reviewed; these are not API prediction settings.
RETRAIN_AUTO_ENABLED=false
PHISHGUARD_PROMOTION_ENABLED=false
PHISHGUARD_MIN_NEW_VERIFIED_RECORDS=1000
PHISHGUARD_MIN_RECORDS_PER_CLASS=100
PHISHGUARD_REVIEW_INTERVAL_DAYS=30
PHISHGUARD_RETRAINING_COOLDOWN_DAYS=7
