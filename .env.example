# Safe local defaults. Promotion and automatic retraining are intentionally off.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=OPTIMUS
PHISHGUARD_DATABASE_PATH=mlops/data/predictions.db
PHISHGUARD_MODEL_BUNDLE_PATH=test_results/cnn_bilstm
PHISHGUARD_CANDIDATE_DIR=artifacts/candidates
PHISHGUARD_MIN_NEW_VERIFIED_RECORDS=1000
PHISHGUARD_MIN_RECORDS_PER_CLASS=100
PHISHGUARD_REVIEW_INTERVAL_DAYS=30
PHISHGUARD_RETRAINING_COOLDOWN_DAYS=7
PHISHGUARD_MAX_CONCURRENT_JOBS=1
PHISHGUARD_URL_RETENTION_DAYS=30
PHISHGUARD_AUTOMATIC_RETRAINING=false
PHISHGUARD_AUTOMATIC_PROMOTION=false
PHISHGUARD_PROMOTION_ENABLED=false
PHISHGUARD_MAX_FALSE_POSITIVE_RATE=0.01
PHISHGUARD_MAX_FALSE_NEGATIVE_RATE=0.01
PHISHGUARD_MIN_RECALL_PHISHING=0.99
LOG_LEVEL=INFO
