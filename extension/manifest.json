{
  "manifest_version": 3,
  "name": "OPTIMUS",
  "version": "1.2.1",
  "description": "Automatically detects phishing websites using a CNN-BiLSTM model.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://optimus-eewm.onrender.com/*"
  ],
  "action": {
    "default_title": "OPTIMUS",
    "default_icon": "OptimUS Neon Robot Emblem.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
