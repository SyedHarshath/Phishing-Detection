{
  "manifest_version": 3,
  "name": "OPTIMUS",
  "version": "1.2.0",
  "description": "Automatically detects phishing websites using a CNN-BiLSTM model.",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "OPTIMUS",
    "default_icon": "optimus.png",
    "default_popup": "popup.html"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
